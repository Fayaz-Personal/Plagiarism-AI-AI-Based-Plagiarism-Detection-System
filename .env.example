# PlagiarismAI Environment Configuration Example
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Upload limits
MAX_CONTENT_LENGTH_MB=10

# AI/NLP Algorithm Settings
SENTENCE_SIMILARITY_THRESHOLD=0.70
MIN_SENTENCE_LENGTH=20

# Demo Category Thresholds (Percentages)
SIMILARITY_THRESHOLD_LOW=10.0
SIMILARITY_THRESHOLD_MODERATE=30.0
SIMILARITY_THRESHOLD_HIGH=60.0
